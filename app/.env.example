# SHUTDOWN 2026-07-20: GEMINI_API_KEY revoked — leadjin services deactivated
# GEMINI_API_KEY: Required for AI lead generation.
# GEMINI_API_KEY=

# D3 (2026-10-20): Testing-only provider flags.
# LEADJIN_TESTING_MODE: Set to "1" to enable Apollo/Snov as testing-only legs
#   with per-day caps. When unset or "0" (default), production runs on the
#   model key (GEMINI_API_KEY) + SMTP verify alone — no Apollo/Snov required.
# LEADJIN_TESTING_MODE=1

# LEADJIN_TESTING_CAP: Per-day cap on testing-only provider API calls (default: 20).
#   Enforced in-process per UTC day. Never raise without Founder approval.
# LEADJIN_TESTING_CAP=20

# Testing-only provider keys (only used when LEADJIN_TESTING_MODE=1):
# APOLLO_API_KEY=
# SNOV_API_KEY=
# SNOV_API_SECRET=

# ---------------------------------------------------------------------------
# AI Provider routing (LEADJIN_PROVIDER)
# Default: ollama (local, no key, no cost).
# Free serverless options for eval/prototype (zero-cost, no billing cap):
#   openrouter  → OpenRouter free tier (openrouter/auto router)
#   together    → Together AI (Qwen/Qwen3-8B, free tier)
#   nvidia      → NVIDIA Build (meta/llama-3.1-8b-instruct, dev only)
#   nous        → Nous Portal (stepfun/step-3.7-flash:free, $0 plan)
# Paid production option:
#   gateway     → Hermes API gateway (google/gemini-2.5-flash-lite, monthly cap enforced)
# LEADJIN_PROVIDER=ollama

# Free provider API keys (required when LEADJIN_PROVIDER is set to the matching provider):
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# NVIDIA_API_KEY=
# NOUS_API_KEY=

# OpenRouter free-router attribution (required for free tier):
# LEADJIN_OPENROUTER_SITE_URL=https://leadjin.app
# Override the default free model for each provider (optional):
# LEADJIN_OPENROUTER_MODEL=openrouter/auto
# LEADJIN_TOGETHER_MODEL=Qwen/Qwen3-8B
# LEADJIN_NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# LEADJIN_NOUS_MODEL=stepfun/step-3.7-flash:free

# APP_URL: The URL where this app is hosted (used for OAuth callbacks).
APP_URL=http://localhost:3001

# Server
PORT=3001

# Database
DATABASE_PATH=./leadjin.db

# Email Configuration (SMTP — for outreach queue)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin Dashboard (required for email unsubscribe security)
LEADJIN_ADMIN_SECRET=

# Founder email (optional - for founder-specific privileges)
FOUNDER_EMAIL=

# Google OAuth (Gmail sending only; calendar is open-source iCalendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Google Places discovery (legacy endpoints: Text Search / Details / Find Place).
# Mint at Google Cloud Console > APIs & Services > Credentials > Create Application
# credentials > API key, with "Places API" enabled. Paste once into work/leadjin/app/.env
# as GOOGLE_PLACES_API_KEY (hidden entry, never committed, never logged).
GOOGLE_PLACES_API_KEY=

# WhatsApp Business API (optional — legacy stub, replaced by the QR bridge)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# WhatsApp QR bridge (Baileys, QR-linked personal number) — replaces the
# Business-API stub. The bridge runs as a sibling worker:
#   node bridge.js --port <port> --session <sessionDir>
# Env: WHATSAPP_BRIDGE_URL (default http://localhost:3010), WHATSAPP_BRIDGE_PORT
# (default 3010; 3000 is in use on this host — see config.yaml platforms.whatsapp.extra.bridge_port).
WHATSAPP_BRIDGE_URL=http://localhost:3010
WHATSAPP_BRIDGE_PORT=3010
WHATSAPP_SESSION_DIR=./workers/whatsapp-bridge/session

# Documented keys (no value set here; supplied via .env or environment at deploy):
# LEADJIN_MODEL=
# LEADJIN_PROVIDER=
# WATHQ_CONSUMER_KEY=
