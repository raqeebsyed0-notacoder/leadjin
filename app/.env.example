# SHUTDOWN 2026-07-20: GEMINI_API_KEY revoked — leadjin services deactivated
# GEMINI_API_KEY: Required for AI lead generation.
# GEMINI_API_KEY=

# D3 (2026-10-20): Testing-only provider flags.
# LEADJIN_TESTING_MODE: Set to "1" to enable Apollo/Snov as testing-only legs
#   with per-day caps. When unset or "0" (default), production runs on the
#   model key (GEMINI_API_KEY) + SMTP verify alone — no Apollo/Snov required.
# LEADJIN_TESTING_MODE=1

# LEADJIN_TESTING_CAP: Per-day cap on testing-only provider API calls (default: 20).
#   Enforced in-process per UTC day. Never raise without Founder approval.
# LEADJIN_TESTING_CAP=20

# Testing-only provider keys (only used when LEADJIN_TESTING_MODE=1):
# APOLLO_API_KEY=
# SNOV_API_KEY=
# SNOV_API_SECRET=

# APP_URL: The URL where this app is hosted (used for OAuth callbacks).
APP_URL=http://localhost:3001

# Server
PORT=3001

# Database
DATABASE_PATH=./leadjin.db

# Email Configuration (SMTP — for outreach queue)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin Dashboard (required for email unsubscribe security)
LEADJIN_ADMIN_SECRET=

# Founder email (optional - for founder-specific privileges)
FOUNDER_EMAIL=

# Google OAuth (Gmail + Calendar integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# WhatsApp Business API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
