  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build:server": "tsc --project tsconfig.server.json",
    "kill": "npx kill-port 3000 3001 24700",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "cap:init": "npx cap init LeadJin com.leadjin.app --web-dir=dist",
    "cap:add-android": "npx cap add android",
    "cap:copy": "npx cap copy android",
    "cap:open": "npx cap open android",
    "cap:sync": "npm run build && npx cap copy android"
  },
