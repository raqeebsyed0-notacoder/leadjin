node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Database
*.db
*.db-journal
*.sqlite
*.sqlite3

# SQLite WAL/SHM runtime artifacts (SSD write-ahead cache; never committed)
*.db-shm
*.db-wal

# Backup / source-snapshot files (never committed)
*.bak
*.bak-*

# Working artifacts and source snapshots (never committed)
workers/*/node_modules/
backups-*/
_archive/
.leadjin/
*.pre-move-*
*.pre-fix-*
.audit_perf_idx.txt
tmp-check-*

# Python caches
__pycache__/
*.pyc
